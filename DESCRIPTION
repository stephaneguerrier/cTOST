Package: cTOST
Type: Package
Title: Finite Sample Correction of the Two One-Sided Tests
Version: 1.1.0
Authors@R: c(
    person("Stéphane", "Guerrier", email = "stef.guerrier@gmail.com", role = c("aut","cre","cph")),
    person("Younes", "Boulaguiem", role = c("aut","cph")),
    person("Dominique-Laurent", "Couturier", role = c("aut","cph")),
    person("Luca", "Insolia", role = c("aut","cph")),
